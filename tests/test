#!/bin/sh
rm -f 32.asm
rm -f 64.asm
rm -f 32
rm -f 64
clear
echo "BITS 32" > 32.asm
echo "BITS 64" > 64.asm
cat code.asm >> 32.asm
cat code.asm >> 64.asm
echo '------------------ 32 BITS ---------'
nasm 32.asm && ndisasm -b 32 32
echo '------------------ 64 BITS ---------'
nasm 64.asm && ndisasm -b 64 64
